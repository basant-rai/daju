# Supabase — get from: supabase.com → your project → Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Your app's public URL (used for generating check-in links)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# From Supabase: run `select id from organizations limit 1;`
NEXT_PUBLIC_ORG_ID=your-org-uuid-here

# Displayed in the sidebar
NEXT_PUBLIC_ORG_NAME=My Gym
